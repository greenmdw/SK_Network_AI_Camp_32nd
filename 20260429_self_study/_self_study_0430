"""
<<format 서식>>
다른열 값 사이에 다른 종류의 값이나 변수를 적용하려고 할 때 이용
정수 십진수(decimal) %d
정수 팔진수(octal) %o
정수 십육진수(hex) %x
실수형 숫자(float) %f
문자열(str) %s
"""
age = int(input("나이: "))
height = float(input("키: "))

print('나이는 {0}세이고, 키는 {1:.1f}cm 입니다'.format(age, height))
print('나이는 %d세이고, 키는 %.1fcm 입니다.'%(age, height))


