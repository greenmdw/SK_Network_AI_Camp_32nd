# 9. itemset 지지도 계산 함수 정의

# 이 함수는 특정 아이템 조합이 전체 거래에서 얼마나 자주 함께 등장하는지 계산
# ['whole milk', 'yogurt']가 전체 거래 중 몇 %에서 함께 등장하는지 계산
def calculate_itemset_support(x, item_indices):
    # item_indices는 계산할 아이템들의 열 번호 리스트
    item_indices = list(item_indices)

    # x[: item_indices]는 전체 거래에서 해당 아이템 열들만 선택
    selected = x[:, item_indices]

    # selected.prod(dim=1)은 한 거래 안에서 선택 아이템들이 모두 1인지 확인
    # 아래 값이 1이면 모두 구매했다는 뜻이고, 0이면 하나라도 구매 안함
    both_purchased = selected.prod(dim=1)

    # 평균을 계산하면 전체 거래 중 해당 itemset이 등장한 비율 됨
    # .item() : pytorch tensor 타입에서 파이썬 숫자 형태로 값 변환
    support = both_purchased.mean().item()

    return support

# <테스트>
# 지지도 상위 2개 아이템이 함께 등장하는 비율 계산
