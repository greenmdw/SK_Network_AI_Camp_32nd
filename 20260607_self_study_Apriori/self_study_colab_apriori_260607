# 단일 아이템 중 최소 지지도 이상인 아이템을 후보로
frequent_single_items = [
    item_to_idx[row.item]
    for row in item_freq_df.itertuples(index=False)
    if row.support >= MIN_SUPPORT
]

# frequent_itemsets 딕셔너리는 itemset 튜플을 key, 지지도를 value로 지정
frequent_itemsets = {}

# L_1: frequent 1-itemsets
# frozenset을 키로 사용하여 집합 연산에 용이하게 저장하고, 이후 tuple로 변환
L_prev = {frozenset((item_idx,)): item_support_tensor[item_idx].item()
            for item_idx in frequent_single_items}

# L_1을 전체 frequent_itemsets 컬렉션에 추가합니다.
for fs, support in L_prev.items():
    frequent_itemsets[tuple(sorted(list(fs)))] = support

# 후보 단일 아이템 수를 출력
print('최소 지지도 이상 단일 아이템 수: ', len(frequent_single_items))

# 2개부터 MAX_LEN개 까지 아이템 조합 생성(Aprori 알고리즘)
for k in range(2, MAX_LEN + 1):
    current_L_k = {}            # 현재 길이 k의 빈발 itemset을 저장할 딕셔너리
    candidate_k_itemsets = set()    # 후보 k-itemset을 저장할 set(frozenset 사용)

    # L_prev (이전 단계의 빈발(k-1)-itemset)의 키를 정렬된 튜플 리스트로 변환
    list_L_prev_keys = sorted([tuple(sorted(list(fs))) for fs in L_prev.keys()])

    # 이전 단계의 빈발 itemset이 없으면 더이상 큰 itemset을 만들 수 없습니다.
    if not list_L_prev_keys:
        break

    # Join Step: L_prev의 itemset들을 결합하여 후보 K-itemset을 생성
    for i in range

