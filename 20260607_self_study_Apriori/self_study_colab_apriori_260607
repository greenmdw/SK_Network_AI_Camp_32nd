# 3. 거래 데이터 읽기

# 각 원소는 한 번의 장보기에서 구매한 아이템 이름들의 리스트
transactions = []           # 전체 거래 데이터 저장

# csv 파일 한 줄씩 읽기
with open(DATA_PATH, 'r', encoding='utf-8') as f:
    for line in f:
        # strip()은 줄 바꿈 문자와 양끝 공백을 제거합니다.
        line = line.strip()

        # 빈 줄은 거래 데이터가 아니므로 건너뜀
        if line == "":
            continue

        # split(",")은 쉼표 기준으로 아이템 이름을 분리합니다.
        items = line.split(',')

        # 아이템 이름에서 양쪽 공백 제거하고 빈 문자열 제외
        items = [item.strip() for item in items if item.strip() != '']

        # 한 거래 안에서 같은 아이템이 중복될 수 있으므로 set 으로 중복 제거
        items = list(set(items))

        # 정리된 거래를 전체 transactions 리스트에 추가
        transactions.append(items)

# 전체 거래 수를 계산합니다.
num_transactions = len(transactions)

# 전체 아이템 목록을 만들기 위해 모든 거래의 아이템을 하나의 set에 모읍니다.
all_items = sorted(set(item for transaction in transactions for item in transaction))

# 전체 고유 아이템 수를 계산
num_items = len(all_items)

print('전체 거래 수: ', num_transactions)
print('전체 고유 아이템 수: ', num_items)

print('처음 5개 거래: ')
