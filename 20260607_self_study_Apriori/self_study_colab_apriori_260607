# 4. 거래 데이터를 one-hot 희소 행렬로 변환

# item_to_idx 는 아이템 이름을 열 번호로 바꾸기 위한 딕셔너리
item_to_idx = {item: idx for idx, item in enumerate(all_items)}

# idx_to_item은 열 번호를 다시 아이템 이름으로 바꾸기 위한 딕셔널
idx_to_item = {idx: item for item, idx in item_to_idx.items()}

# torch.zeros()로 거래 수 x 아이템 수 크기의 행렬 생성
x = torch.zeros((num_transactions, num_items))

# 각 거래순회하며 구매 아이템에 1 표시
for row_idx, transaction in enumerate(transactions):
    for item in transaction:
        # 아이템 이름을 열 번호로 변환
        col_idx = item_to_idx[item]

        # 해당 거래(row_idx)에서 해당 아이템(col_idx)을 구매했으므로 1로 표시
        x[row_idx, col_idx] = 1.0

print('one_hot 행렬 크기: ', x.shape)
print(x[:5, :10])
print(all_items[:10])

# 5. 아이템 빈도와 지지도 계산

# 지지도(support)는 전체 거래 중 특정 아이템이 등장한 거래 비율
# x.mean(dim=0) 은 각 열의 평균값
# one-hot 값이 0 또는 1이므로 평균은 곧 각 아이템의 거래 비율, 즉 지지도
item_support_tensor = x.mean(dim=0)

# torch 텐서를 pandas DF로 변환하기 위해 numpy로 바꿈
item_support = item_support_tensor.numpy()

# 아이템 지지도 표
item_freq_df = pd.DataFrame({
