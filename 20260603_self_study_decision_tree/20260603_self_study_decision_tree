print('라벨 매핑')
for original, encoded in zip(label_encoder.classes_, unique_encoded_labels):
    print(f"{original} -> {encoded}")

# 7. 수치형 컬럼과 범주형 컬럼 구분

numeric_features = x.select_dtypes(include=['int64', 'float64']).columns.tolist()
