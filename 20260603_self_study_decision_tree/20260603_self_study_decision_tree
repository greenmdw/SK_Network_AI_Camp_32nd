"""### 6. 입력 데이터와 정답 데이터 분리"""

# 6. 입력 x와 정답 y 분리

target_col = 'Repay'
if target_col not in credit_info.columns:
  raise ValueError('데이터에 목표 column이 없습니다.')

x = credit_info.drop(columns=[target_col])
y = credit_info[target_col]

# label encoder는 문자 라벨을 숫자 라벨로 바꿉니다.
label_encoder = LabelEncoder()
y_encoded = label_encoder.fit_transform(y)

# 1. 먼저 y_encoded에서 고유한 숫자값만 뽑아내어 변수에 담습니다.
unique_encoded_labels = np.unique(y_encoded)

