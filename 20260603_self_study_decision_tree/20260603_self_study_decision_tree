x_train, x_test, y_train, y_test = train_test_split(
    x,
    y_encoded,
    test_size=0.2,
    random_state = SEED,
    stratify=y_encoded
)

print('x_train 크기: ', x_train.shape)
print('y_train 크기: ', y_train.shape)

"""### 7. 데이터 전처리"""

# 9. 데이터 전처리 파이프라인
# 숫자형 컬럼 정규화
numeric_transformer = Pipeline(
    steps=[
        ('scaler', StandardScaler())
    ]
)
# 카테고리형 컬럼 정규화. 카테고리를 숫자 벡터화 처리
categorical_transformer = Pipeline(
    steps = [
        ('onehot', OneHotEncoder(handle_unknown='ignore'))
    ]
)
# 두 정규화를 하나로 합침. ColumnTransformer는 컬럼 종류별로 다른 전처리 적용가능.
preprocessor = ColumnTransformer(
    transformers = [
        ('num', numeric_transformer, numeric_features),
        ('cat', categorical_transformer, categorical_features)
    ]
)

# 위에서 정의한 카테고리 및 숫자
# preprocessor를 쓴 이유는 트레인 데이터 셋 안에 숫자형과 카테고리형 컬럼이 혼재해 있기 때문
x_train_processed = preprocessor.fit_transform(x_train)
x_test_processed = preprocessor.transform(x_test)

# OneHotEncoding 결과가 희소행렬일 수 있으므로 numpy로 변환
# toarray: 희소행렬 처리. 0을 다 채워 넣은 일반적인 행렬로 복원.
x_train_processed = x_train_processed.toarray() if hasattr(x_train_processed, 'toarray') else x_train_processed
x_test_processed = x_test_processed.toarray() if hasattr(x_test_processed, 'toarray') else x_test_processed

# 최종적으로 PyTorch는 float32 자료형을 사용하기 때문에 flat32로 변환
x_train_processed = x_train_processed.astype(np.float32)
x_test_processed = x_test_processed.astype(np.float32)

# 정답 라벨 y는 수치가 아니라 '그룹 번호'이기 때문에 PyTorch에서는 정수형인 Int64로 처리
y_train_processed = y_train.astype(np.int64)
y_test_processed = y_test.astype(np.int64)

"""### 8. Dataset과 DataLoader"""

# 10. Dataset 클래스 정의
# Dataset: 데이터를 한 개씩 꺼내는 방법 정의. 데이터 다루는 규칙 담은 클래스
class CreditDataset(Dataset):
  def __init__(self, features, labels):
    # 입력 특성을 텐서로 변환
    self.features = torch.tensor(features, dtype=torch.float32)

    # 정답 라벨을 텐서로 변환
    self.labels = torch.tensor(labels, dtype=torch.long)

  # len은 데이터가 총 몇개인지 반환
  def __len__(self):
    # labels의 길이가 전체 데이터 개수
    return len(self.labels)

  # _getitem 은 특정 번호의 데이터 1개 반환
  def __getitem__(self, idx):
    return self.features[idx], self.labels[idx]


# 학습용 Dataset 객체 생성
train_dataset = CreditDataset(x_train_processed, y_train)

# 테스트용 Dataset 객체 생성
test_dataset = CreditDataset(x_test_processed, y_test)

# 한 번에 학습할 데이터 개수
# 하나씩 학습하면 모델 가중치가 너무 자주 바뀜.
# 32개씩 묶어 평균적인 오차를 계산해 한번에 업데이트.
batch_size = 32

# 학습용 DataLoader 생성
# DataLoader: 데이터를 미니배치 단위로 모델에 공급하며 CPU/GPU 병렬처리 담당
# shuffle=True 는 매 epoch 마다 데이터 순서를 섞어 학습 효과를 높임
train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True)

# 테스트용 Dataloader 생성
# 테스트는 순서를 섞을 필요 없음
test_loader = DataLoader(test_dataset, batch_size=batch_size, shuffle=False)

# 첫 번째 미니배치를 꺼내 입력과 정답 크기를 확인
sample_x, sample_y = next(iter(train_loader))

print('미니배치 입력 크기: ', sample_x.shape)
print('미니배치 정답 크기: ', sample_y.shape)

"""### 10. PyTorch 분류 모델 정의<br>
코드는 C5.0 의사결정 트리 + 다중퍼셉트론(MLP) 사용
- 입력층: 전처리 후 특성 개수
- 은닉층: 1: 64개 뉴런
- 은닉층: 2: 32개 뉴런
- 출력층: 클래스 개수
"""

# 11. PyTorch 모델 정의

# CreditMLP는 대출 상환 여부를 분류하는 신경망 모델
# Perceptron: 기초적인 인공 신경망.
# 하나의 신경망으로는 yes/no 와 같은 단순한 판단만 가능.
# Multi-layer Perceptron: 다중퍼셉트론
class CreditMLP(nn.Module):
  # 모델 정의
  def __init__(self, input_dim, num_classes):
    super(CreditMLP, self).__init__()

    # self.network는 여러 신경망 계층을 순서대로 묶은 구조입니다.
    self.network = nn.Sequential(
        # 1 번째 완전연결층. input_dim을 64개 값으로 변환
        nn.Linear(input_dim, 64),

        # ReLU는 음수는 0으로, 양수는 그대로 통과시키는 활성함수
        # 모델이 복잡한 패턴을 학습할 수 있게 도와줌
        nn.ReLU(),

        # Dropout은 일부 뉴런을 무작위로 끄는 기법. -> 과적합 줄일수 있음
        nn.Dropout(0.2),

        # 2 번째 완전연결층. 64개 받아서 32개 값으로 변환
        nn.Linear(64, 32),

        # 2 번째 ReLU 활성화 함수
        nn.ReLU(),

        # 마지막 출력층. 32개 받고 클래스 개수만큼 정수로 변환
        nn.Linear(32, num_classes)

    )

  # forward는 입력 데이터가 모델을 통과하는 계산 과정 정의
  def forward(self, x):
    # 입력 x를 self.network에 통과 시켜 출력값 만듬
    return self.network(x)


# 입력 특성 개수
input_dim = x_train_processed.shape[1]
# 원핫인코딩 때문에 [1] 값이 늘어남
print(x_train_processed.shape)      # (800, 61)
print(y_train_processed.shape)      # (800, )


# 분류할 클래스 개수
num_classes = len(label_encoder.classes_)

# 모델 객체 생성하고 gpu/cpu로 이동
model = CreditMLP(input_dim=input_dim, num_classes=num_classes).to(device)

print(model)

# 11. 손실함수와 최적화 알고리즘 설정

# CrossEntropyLoss 다중 분류 문제에서 많이 사용되는 손실 함수
# 모델의 예측이 정답과 얼마나 다른지 숫자로 계산
criterion = nn.CrossEntropyLoss()

# Adam은 학습률을 자동으로 조정해가며 모델 파라미터 업데이트 하는 최적화 알고리즘
optimizer = optim.Adam(
    model.parameters(),
    lr=0.001
)

"""### 10. 모델 학습"""

# 13. 평가 함수 정의

def evaluate(model, data_loader, criterion):
  # 평가 모드로 바꾸며 dropout 같은 학습 전용 동작이 꺼짐
  model.eval()

  # 전체 손실값을 누적할 변수
  total_loss = 0.0
  # 맞힌 개수를 누적할 변수
  correct = 0
  # 전체 데이터 개수를 누적할 변수
  total = 0

  with torch.no_grad():
    for batch_x, batch_y in data_loader:
      # 입력 데이터를 학습 장치로 이동
      batch_x = batch_x.to(device)

      # 정답 라벨을 학습 장치로 이동
      batch_y = batch_y.to(device)

      # 모델에 입력 데이터를 넣어 예측 점수 계산
      outputs = model(batch_x)

      # 예측 점수와 정답 사이의 손실값 계산
      loss = criterion(outputs, batch_y)

      # 현재 미니배치 손실값에 데이터 개수를 곱해 누적
      # loss.item(): 데이터 한 개당 평균 손실값.
      # PyTorch는 기본적으로 batch에 포함된 데이터들의 손실값을 평균으로 반환
      # batch_x.size(0) 이유: 마지막 배치는 32개가 안 될 수 있어서 배치 사이즈로 곱
      total_loss += loss.item() * batch_x.size(0)

      # 모델이 낸 점수 중 누가 가장 높은 점수인지 인덱스로 값 찾기
      # torch.max(outputs, 1) :행렬의 가로 방향으로 최대값을 찾아라
      # _: 우리는 맥스 값이 얼마인지 보다 몇 번째 클래스인지 인덱스 값이 중요
      _, predicted = torch.max(outputs, 1)

      # 전체 데이터 개수를 누적합니다.
      total += batch_y.size(0)

      # 예측값과 정답이 같은 개수를 누적
      correct += (predicted == batch_y).sum().item()

  # 평균 손실값 계산
  avg_loss = total_loss / total

  # 정확도 계산
  accuracy = correct / total

  # 평균 손실값과 정확도 반환
  return avg_loss, accuracy

# 14 모델 학습

epochs = 50

train_losses = []
train_accuracies = []
test_losses = []
test_accuracies = []

for epoch in range(epochs):
  model.train()
  running_loss = 0.0
  correct = 0
  total = 0
  for batch_x, batch_y in train_loader:
    batch_x = batch_x.to(device)
    batch_y = batch_y.to(device)
    optimizer.zero_grad()
    outputs = model(batch_x)
    loss = criterion(outputs, batch_y)
    loss.backward()
    optimizer.step()

    # 현 미니배치 손실값 누적
    running_loss += loss.item() * batch_x.size(0)

    # 가장 큰 점수를 가진 클래스를 예측값으로 선택
    _, predicted = torch.max(outputs, 1)

    # 전체 데이터 개수를 누적
    total += batch_y.size(0)

    correct += (predicted == batch_y).sum().item()

  # 한 epoch의 평균 학습 손실값 계산
  train_loss = running_loss / total

  # 한 epoch의 학습 정확도
  train_acc = correct / total

  # 테스트 데이터에 대한 손실값과 정확도
  test_loss, test_acc = evaluate(model, test_loader, criterion)

  # 그래프 출력을 위한 리스트 저장
  train_losses.append(train_loss)
  train_accuracies.append(train_acc)
  train_losses.append(test_loss)
  test_accuracies.append(test_acc)

  # 결과 출력
  print(
      f'Epoch [{epoch + 1:02d}/{epochs}] '
      f'Train Loss: {train_loss: .4f}, Train Acc: {train_acc: .4f}, '
      f'Test Loss: {test_loss: .4f}, Test Acc {test_acc: .4f}'
  )

# 15. 학습 과정 그래프 출력

plt.figure(figsize=(8, 5))
plt.plot(train_losses, label="Train Loss")
plt.plot(test_losses, label="Test Loss")
plt.title('Loss Changes')
plt.xlabel('Epoch')
plt.ylabel('Loss')
plt.legend()
plt.show()

plt.figure(figsize=(8, 5))
plt.plot(train_accuracies, label='Train Accuracy')
plt.plot(test_accuracies, label='Test Accuracy')
plt.title('Accurach Change')
plt.xlabel('epoch')
plt.ylabel('Accuracy')
plt.legend()
plt.show()

model.eval()
#  예측 저장 리스트
all_predictions = []
# 정답 저장 리스트
all_labels = []

with torch.no_grad():
  for batch_x, batch_y in test_loader:
    batch_x = batch_x.to(device)

    # 모델 예측 점수 계산
    output = model(batch_x)

    # 가장 높은 클래스를 예측 값으로 선택
    _, predicted = torch.max(output, 1)

    # 예측값을 cpu로 옮긴 뒤 numpy 배열로 변환하여 리스트에 추가
    all_predictions.extend(predicted.cpu().numpy())

    # 실제 정답도 numpy배열로 변환하여 리스트에 추가
    all_labels.extend(batch_y.numpy())

all_predictions = np.array(all_predictions)
all_labels = np.array(all_labels)

test_accuracy = accuracy_score(all_labels, all_predictions)

print(round(test_accuracy, 4))

# 17. Confusion Matrix 출력

cm = confusion_matrix(all_labels, all_predictions)

# cm을 표 형태의 df로 변환
