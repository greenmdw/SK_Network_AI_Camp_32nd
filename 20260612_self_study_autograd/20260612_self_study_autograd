# 1. Import Library
import torch
import torch.nn as nn
import torch.optim as optim
import matplotlib.pyplot as plt
from types import SimpleNamespace

torch.manual_seed(42)
print('PyTorch 버전: ', torch.__version__)

# 2-1 Tensor 생성하기
# 3행 4열 표준편차 1, 평균 0을 따르는 난수 생성
x_tensor = torch.randn(3, 4)
print(x_tensor)

# 2-2 자동 미분 가능한 Tensor 생성
# regular_grad=True는 tensor가 이용한 모든 연산을 pytorch가 추적하겠다는 의미
# 즉, 나중에 backward()를 호출하면 이 tensor에 대한 기울기를 자동 계산할 수 있음
x = torch.randn(3, 4, requires_grad=True)
print('x값: \n',x)

# 아직 backward 실행하지 않았기 때문에 x.grad 는 None
# grad 는 손실 함수가 x에 대해 얼마나 민감하게 변하는지 나타냄
print('초기 gradient: ', x.grad)

# 2-3 .data, .grad, .requires_grad 이해하기

# .detach()는 현재 tensor 값을 계산 그래프에서 분리
# 예전 코드의 .data와 비슷하게 값을 확인하는 용도로 사용
x_value_only = x.detach()
print('detach 후: \n', x_value_only)

# x.grad는 현재까지 계산된 x의 기울기를 저장
# 아직 backward()를 수행하지 않았으므로 None 출력
print('현재 x.grad', x.grad)

# x가 자동 미분 대상인지 확인하는 속성
print('x.requires_grad: ', x.requires_grad)

# 3-1 계산 그래프 만들기

# x는 자동 미분 대상 Tensor입니다.
# requires_grad=True이므로 x가 포함된 연산은 계산 그래프에 기록됨
x = torch.randn(3, 4, requires_grad=True)

y = x ** 2 + 4 * x
z = 2 * y + 3
print("x.requires_grad:", x.requires_grad)
print("y.requires_grad:", y.requires_grad)
print("z.requires_grad:", z.requires_grad)

# z의 grad_fn은 z가 어떤 연산으로 만들어 졌는지 보여줌
print('z.grad_fn: ', z.grad_fn)
print(z.grad_fn.next_functions)

# 3-2. backward() 기울기 계산

# z는 3행 4열 tensor이므로 바로 backward()를 호출하려면 같은 크기의 gradient 인자가 필요
# 여기서는 z의 모든 원소를 같은 중요도로 도한다고 가장하기 위해 torch.ones_like(z)사용
gradient_input = torch.ones_like(z)

z.backward(gradient_input)

# x.grad에는 z가 x에 대해 얼마나 민감하게 변하는지에 대한 기울기가 저장
# z = 2(x^2 + 4x) + 3 = 2x^2 + 8x + 3 이므로 dz/dx = 4x + 8 입니다.
print('자동 미분으로 계산된 x.grad: ')
print(x.grad)

# 이론적으로 계산한 기울기 4x + 8을 직접 계산
manual_gradient = 4 * x.detach() + 8

# 자동 미분 결과와 직접 계산 결과가 같은지 비교
print('직접 계산한 기울기 4x + 8')
print(manual_gradient)

# torch.allclose는 두 tensor값이 거의 같은지 확인
# 부동소수점 계산은 아주 작은 오차가 있을 수 있으므로 완전 일치 대신 allclose사용
print("자동 미분 결과와 직접 계산 결과가 같은가?:", torch.allclose(x.grad, manual_gradient))

# 4-1. 학습 설정값

# 학습에 사용할 주요 설정값 config 객체에 저장
config = SimpleNamespace(
    learning_rate=0.01,
    epochs=100,
    model='Linear Regression',
    optimizer='SGD',
    loss_function='MSELoss'
)

print("학습률:", config.learning_rate)
print("반복 횟수:", config.epochs)
print("모델:", config.model)
print("최적화 알고리즘:", config.optimizer)
print("손실 함수:", config.loss_function)

# 4-2. 학습 데이터 생성

# unsqueeze(1)는 모양을 내서 [100]에서 [100, 1]로 바꾸어 모델 입력 형태에 맞춤
x = torch.linspace(-5, 5, 100).unsqueeze(1)

# 실제 정답률 관계를 y = 2x + 1로 가정
# 여기에 작은 난수잡음을 더해 실제 데이터 처럼 완전히 직선이 아니게 됨
y = 2 * x + 1 * 0.5 * torch.randn(x.size())

print('x 크기: ', x.shape)
print('y 크기: ', y.shape)
print('앞 5개 x: ', x[:5])
print('앞 5개 y: ', y[:5])

# 4-3. 선형 회귀 모델, 손실 함수, 최적화 알고리즘 정의
model = nn.Linear(1, 1)

# nn.MSELoss()는 평균제곱오차 손실 함수
# 회귀 문제에서 자주 사용
criterion = nn.MSELoss()

# optim.sgd는 경사하강법
# model.parameters()는 학습 가능한 weight와 bias 를 optimizer에 전달.
optimizer = optim.SGD(model.parameters(), lr=config.learning_rate)

print('모델: \n', model)
print('초기 weight: ', model.weight.item())
print('초기 bias: ', model.bias.item())

# 4-4. 학습 및 기록 저장

epoch_history = []
loss_history = []
weight_history = []
bias_history = []
for epoch in range(config.epochs):
    optimizer.zero_grad()
    predictions = model(x)
    loss = criterion(predictions, y)
    loss.backward()
    optimizer.step()

    current_epoch = epoch + 1
    current_loss = loss.item()
    current_weight = model.weight.item()
    current_bias = model.bias.item()

    epoch_history.append(current_epoch)
    loss_history.append(current_loss)
    weight_history.append(current_weight)
    bias_history.append(current_bias)

    if current_epoch % 10 == 0:
        print(f'Epoch [{current_epoch} / {config.epochs} | Loss: {current_loss} | Weight: {current_weight}, Bias: {current_bias}]')

# 4-5. 학습 결과 확인

print('최종 weight: ', model.weight.item())
print('최종 bias : ', model.bias.item())

# 5. 모델 평가
with torch.no_grad():
    final_predictions = model(x)
    final_loss = criterion(final_predictions, y)

print('최종 손실 값: ', final_loss.item())

plt.figure(figsize=(8, 5))
plt.plot(epoch_history, loss_history)
plt.title('Loss History')
plt.grid(True)
plt.show()

plt.figure(figsize=(8, 5))
plt.plot(epoch_history, weight_history, label='Weight')
plt.plot(epoch_history, bias_history, label='Bias')
plt.title('Weight, Bias History')
plt.xlabel('epoch')
plt.ylabel('Parameter value')
plt.legend()
plt.grid(True)
plt.show()

# scatter()는 실제 학습 데이터를 점으로 표시
# x.detach()는 tensor를 계산 그래프에서 분리하여 그래프 출력용으로 값 사용
plt.scatter(x.detach(), y.detach(), label='Training Data')
plt.plot(x.detach(), final_predictions.detach(), label='Model Prediction')
plt.title('final linear Regression Result')
plt.xlabel('x')
plt.ylabel('y')
plt.legend()
plt.grid(True)
plt.show()

"""# **TensorFlow / Keras 기반 MNIST 손글씨 숫자 분류**

TensorFlow는 딥러닝 모델을 만들고 학습시키기 위한 대표 라이브러리.

Keras는 TensorFlow안에서 신경망 모델을 더 쉽게 만들 수 있도록 도와주는 고수준 API.
"""

# 1. Import Library
import tensorflow as tf
import numpy as np
import matplotlib.pyplot as plt
import os

# TF의 불필요한 안내 로그를 줄이기 위한 설정
os.environ['TF_CPP_MIN_LOG_LEVEL'] = '2'

# 실험 결과를 가능한 재현 가능하게 위한 난수 시드 고정
tf.keras.utils.set_random_seed(42)

print('TensorFlow 버전: ', tf.__version__)

# 2. TensorFlow 텐서 생성과 출력
msg = tf.constant('hello')
tf.print(msg)

# 3. MNIST 데이터셋 불러오기
mnist = tf.keras.datasets.mnist
(X_train, Y_train), (X_test, Y_test) = mnist.load_data()

# 4. Check image
plt.imshow(X_train[0], cmap='gray')
plt.axis('off')
plt.show()

# 첫 번째 이미지 배열 출력
print('첫 번째 이미지 y 값: ', Y_train[0])
print('첫 번째 이미지 배열: \n', X_train[0])

# 5. 이미지 데이터 정규화
# 데이터를 255.0으로 나누어 0 ~ 1 범위의 실수 데이터로 변환
X_train = X_train.astype('float32') / 255.0

X_test = X_test.astype('float32') / 255.0

# 정구화한 뒤 이미지 다시 확인
plt.imshow(X_train[0], cmap='gray')
plt.axis('off')
plt.show()

print('정규화 한 후 첫 번째 학습용 데이터 입력값: \n')
print(X_train[0])
print("정규화 후 학습 데이터 최소값:", X_train.min())
print("정규화 후 학습 데이터 최대값:", X_train.max())

# 6. DNN 모델 설계

# Sequential은 층을 순서대로 쌓아 만드는 가장 기본적인 모델 클래스
model = tf.keras.Sequential([
    tf.keras.Input(shape=(28, 28)),
    tf.keras.layers.Flatten(),
    tf.keras.layers.Dense(128, activation='relu'),
    tf.keras.layers.Dropout(0.2),
    tf.keras.layers.Dense(10, activation='softmax')
])

model.summary()

# 7. Model Compile
# 모델을 학습하기 전에는 compile()로 학습환경을 설정해야 합니다.
# optimizer, loss, metrics

model.compile(
    optimizer='adam',
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

# 8. 모델 훈련

# fit() 함수는 모델을 학습시키는 함수
# 학습 과정에서 손실값과 저확도를 출력
history = model.fit(
    X_train,
    Y_train,
    epochs=5,
    batch_size=128,
    validation_split=0.1,
    verbose=1
)

# 학습과정 시각화
# history 객체에는 epoch 손실값과 정확도 변화가 저장됩니다.
# history.hisotry에는 학습 과정에서 기록된 손실값과 정확도가 딕셔너리 형태로 저장됨
print(history.history.keys())

plt.plot(history.history['loss'], label='loss')
plt.title('Epoch loss')
plt.grid(True)
plt.legend()
plt.show()

# 10. Evaluate Model
# eval()는 학습 끝난 모델 평가
# test_loss, test_accuracy는 테스트 데이터에서 계산된 정확도

test_loss, test_accuracy = model.evaluate(
    X_test,
    Y_test,
    verbose=1
)

print('테스트 손실값', test_loss)
print('테스트 정확도: ', test_accuracy)

# 11. 모델 예측
# predict()는 학습된 모델을 사용하여 정답 예측

sample_image = X_test[0]
# 모델은 한번에 여러개의 데이터를 입력받는 구조를 기대해서 (1, 28, 28)을 전달
pick = sample_image.reshape(1, 28, 28)

pred = model.predict(pick)
answer = np.argmax(pred, axis=1)

plt.imshow(sample_image, cmap='gray')
plt.title(f'예측값: {answer[0]} / 실제 정답값: {Y_test[0]}')
plt.axis('off')
plt.show()

print('인공신경망 추측 결과 해석: ', answer[0])
print('정답: ', Y_test[0])

# 12. 여러개의 테스트 이미지
