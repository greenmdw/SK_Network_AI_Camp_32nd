# 1. 기본 라이브러리 임포트
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from time import time
import os
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import TensorDataset, DataLoader
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error, r2_score

SEED = 42
np.random.seed(SEED)
torch.manual_seed(SEED)

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')

print('사용 장치: ', device)
if torch.cuda.is_available():
    print('GPU 이름: ', torch.cuda.get_device_name(0))
else:
    print('Using CPU')

# 2. 하이퍼 파라미터 설정

EPOCHS = 250
BATCH_SIZE = 64
LEARNING_RATE = 0.01
TEST_SIZE = 0.3

print('EPOCHS: ', EPOCHS)
print('BATCH_SIZE: ', BATCH_SIZE)
print('LEARNING_RATE: ', LEARNING_RATE)
print('TEST_SIZE: ', TEST_SIZE)

# 3. housing_csv 데이터 읽기

heading = [
    'CRIM',     # 지역별 범죄율
    'ZN',       # 25,000 평방피트 초과 주거지역 비율
    'INDUS',    # 비소매상업지역 면적 비율
    'CHAS',     # 찰스강 인접 여부, 보통 1 또는 0
    'NOX',      # 일산화질소 농도
    'RM',       # 주택당 평균 방 개수
    'AGE',      # 1940년 이전 건축 주택 비율
    'DIS',      # 고용 중심지까지의 가중 거리
    'RAD',      # 방사형 고속도로 접근성 지수
    'TAX',      # 재산세율
    'PTRATIO',  # 학생-교사 비율
    'LSTAT',    # 저소득층 비율
    'MEDV'      # 주택 가격 중앙값, 예측 대상
]

csv_path = 'housing.csv'

if not os.path.exists(csv_path):
    raise FileNotFoundError(
        'housing.csv 파일을 찾을 수 없습니다.'
        'Google Colab 왼쪽 파일 탭에 housing.csv 업로드 후 다시 실행하세요'
    )

raw = pd.read_csv(csv_path)

if 'MEDV' not in raw.columns and raw.shape[1] == len(heading):
    raw.columns = heading

print('원본 데이터: ', raw.shape)
display(raw.head(10))
print('원본 데이터 통계')
display(raw.describe())

# 4. 결측치 확인 및 기본 데이터 점검

print('컬럼별 결측치 개수-----')
print(raw.isnull().sum())
print('\n컬럼별 데이터 타입------')
print(raw.dtypes)

# 문자형으로 읽힌 숫자 데이터를 숫자형으로 변환
# errors='coerce'는 변환할 수 없는 ㄱ밧이 있으면 NaN으로 바꿈
for col in raw.columns:
    raw[col] = pd.to_numeric(raw[col], errors='coerce')

# 숫자형 변환 후 생긴 결측치가 있다면 평균값으로 채움
# 실무에서는 결측치 처리 방식을 문제 특성에 맞게 결정
if raw.isnull().sum().sum() > 0:
    raw = raw.fillna(raw.mean(numeric_only=True))
    print('결측치를 각 컬럼의 평균값으로 대채 완료')
else:
    print('결측치가 없습니다.')

# 5. z-점수 표준화 수행
scaler = StandardScaler()

# fit = 각 컬럼의 평균과 표준편차 계산
# transform = 계산된 평균과 표준편차를 사용하여 실제 데이터를 변환
z_array = scaler.fit_transform(raw)

# numpy 배열을 pandas df 로 변환
z_data = pd.DataFrame(z_array, columns=raw.columns)
print(z_data.head())
print(z_data.describe())

# 6. 입력 데이터와 x 와 정답 데이터 y 분리

print('분리전 데이터 모양: ', z_data.shape)

x_data = z_data.drop('MEDV', axis=1)
y_data = z_data['MEDV']

print('입력데이터 x 모양: ', x_data.shape)
print('출력데이터 y 모양: ', y_data.shape)

x_train, x_test, y_train, y_test = train_test_split(
    x_data,
    y_data,
    test_size=TEST_SIZE,
    random_state=SEED
)

# 7. 정규화된 데이터 분포 확인 - 상자 그림

plt.figure(figsize=(14, 6))
sns.boxplot(data=raw)
plt.title('Original data')
plt.xticks(rotation=45)
plt.show()

plt.figure(figsize=(14, 6))
sns.boxplot(data=z_data)
plt.title('standardized data')
plt.xticks(rotation=45)
plt.show()

# 8. pandas / numpy 데이터를 PyTorch Tensor로 변환

# Pytorch 모델은 DF를 입력받지 않습니다. 따라서 numpy로 바꾸고 torch로 변환
x_train_tensor = torch.tensor(x_train.values, dtype=torch.float32)
x_test_tensor =torch.tensor(x_test.values, dtype=torch.float32)

# view(-1, 1)은 shape을 [샘플수]에서 [샘플수, 1] 형태로 바꿉니다.
y_train_tensor = torch.tensor(y_train.values, dtype=torch.float32).view(-1, 1)
y_test_tensor = torch.tensor(y_test.values, dtype=torch.float32).view(-1, 1)

print('X_train_tensor 모양:', x_train_tensor.shape)
print('y_train_tensor 모양:', y_train_tensor.shape)
print('X_test_tensor 모양:', x_test_tensor.shape)
print('y_test_tensor 모양:', y_test_tensor.shape)

# tensorDataset은 입력 tensor와 정답 tensor를 묶음
train_dataset = TensorDataset(x_train_tensor, y_train_tensor)

# DataLoader는 Dataset에서 데이터를 batch_size만큼 잘라서 반복적으로 꺼내줌
train_loader = DataLoader(
    dataset=train_dataset,
    batch_size=BATCH_SIZE,
    shuffle=True
)

print('학습 배치 개수: ', len(train_loader))

import torch.nn as nn

# 8. PyTorch DNN 모델 정의

class HousingDNN(nn.Module):
    def __init__(self, input_dim):
        super(HousingDNN, self).__init__()

        # 원본 Keras 모델 구조:
        # Dense(200, activiation='relu')
        # Dence(1000, activation='relu')
        # Dense(1)

        # Pytorch에서는 nn.Linear가 Keras의 Dense와 같은 역할.
        self.net = nn.Sequential(
            # 첫 번째 완전연결층
            # input_dim 개의 입력변수를 받아 200개 뉴런으로 변환
            nn.Linear(input_dim, 200),

            # ReLU는 음수는 0, 양수는 그대로 통과
            # 딥러닝에서 비선형 관계 학습을 위해 사용
            nn.ReLU(),

            # 두 번째 완전연결층
            nn.Linear(200, 1000),
            nn.ReLU(),

            nn.Linear(1000, 500),
            nn.ReLU(),

            # 출력층. 구해야 하는 값은 하나이므로 뉴런 1
            # 회귀 문제에서는 마지막에 sigmoid나 softmax 사용하지 않음
            nn.Linear(500, 1)
        )

    def forward(self, x):
        # forward 함수는 x 계산하는 방법 정의
        return self.net(x)

input_dim = x_train.shape[1]
model = HousingDNN(input_dim).to(device)
print(model)

# 10. 손실 함수와 최적화 함수 설정

 # MSELoss는 평균 제곱 오차입니다.
 # 실제값과 예측값의 차이를 제곱한 뒤 평균을 구합니다.
 # 회귀 문제에서 가장 기본적으로 사용하는 손실 함수
criterion = nn.MSELoss()
optimizer = optim.SGD(model.parameters(), lr=LEARNING_RATE)

print('손실함수', criterion)
print('최적화 함수', optimizer)

# 11. DNN 모델 학습
print('DNN 딥러닝 학습 시작')
begin = time()

# epoch 별 평균 손실값 저장 리스트
train_losses = []

for epoch in range(1, EPOCHS + 1):
    model.train()
    running_loss = 0.0

    # train_loader에서 batch단위로 데이터 꺼냄
    for batch_x, batch_y in train_loader:
        batch_x = batch_x.to(device)
        batch_y = batch_y.to(device)

        optimizer.zero_grad()
        # 순전파
        ouputs = model(batch_x)
        loss = criterion(ouputs, batch_y)
        # 역전파: 손실값을 기준으로 각 파라미터 기울기 계산
        loss.backward()
        # 가중치 업데이트
        optimizer.step()
        # 현재 batch의 손실값에 batch 데이터 수를 곱해 누적
        running_loss += loss.item() * batch_x.size(0)

    # epoch 전체 평균 손실 계산
    epoch_loss = running_loss / len(train_loader.dataset)
    train_losses.append(epoch_loss)

    # 학습 진행 상황을 50 epoch 마다 출력
    if epoch == 1 or epoch % 50 == 0:
        print(f'Epoch [{epoch:4d}/{EPOCHS}] - Train MSE Loss: {epoch_loss:.6f}')

end = time()
print(f'총 딥러닝 학습 시간: {end - begin:.1f}초')

# 12. 학습 손실값 변화 시각화

# 손실값이 epoch 가 증가할 수록 대체로 감소하면 모델이 학습되고 있다는 의미
plt.figure(figsize=(10, 5))
plt.plot(train_losses)
plt.title('Training Loss Curve')
plt.xlabel('epoch')
plt.ylabel('MSE Loss')
plt.grid(True)
plt.show()

# 13. 테스트 데이터 평가

# model.eval()f평가 모드로 전환
model.eval()

with torch.no_grad():
    x_test_device = x_test_tensor.to(device)
    y_test_device = y_test_tensor.to(device)

    test_pred_tensor = model(x_test_device)
    test_loss = criterion(test_pred_tensor, y_test_device).item()

print(f'DNN 테스트 평균 제곱 오차(MSE): {test_loss:.6f}')

# sklearn 평가지표 계산을 위해 tensor를 numpy로
y_test_np = y_test_tensor.numpy()
pred_np = test_pred_tensor.cpu().numpy()

# 원래값의 단위와 비슷하게 해석할 수 있는 RMSE
rmse = np.sqrt(mean_squared_error(y_test_np, pred_np))
# r2 값은 모델이 정답의 변동성을 얼마나 설명하는지 보여주는 지표
# 1에 가까울 수록 좋음
r2 = r2_score(y_test_np, pred_np)

print(f'RMSE: {rmse:.6f}')
print(f'r2 score: {r2:.6f}')

# 14. 실제값과 예측값 비교 산포도

plt.figure(figsize=(7, 6))
sns.regplot(x=y_test_np.flatten(), y=pred_np.flatten())
plt.xlabel('Actual Values')
plt.ylabel('predicted values')
plt.title('Actual vs predict')
plt.grid(True)
plt.show()

# 15. 예측결과 일부 확인
result_df = pd.DataFrame({
    'Actual_MEDV_Zscore': y_test_np.flatten(),
    'Predicted_MEDV_Zscore: ': pred_np.flatten(),
    'error': y_test_np.flatten() - pred_np.flatten()
})

print('예측결과 샘플 10개')
display(result_df.head(10))

# 16. 원래 MEDV 단위로 예측값 복원

# scaler.mean_과 scaler.scale_에는 각 컬럼의 평균과 표준편차가 저장되어 있음
# MEDV 컬럼의 위치를 찾습니다.
medv_index = list(raw.columns).index('MEDV')
medv_mean = scaler.mean_[medv_index]
medv_std = scaler.scale_[medv_index]

# z-score 를 원래 값으로 복원하는 공식
# 원래값 = z값 * 표준편차 + 평균
actual_medv_original = y_test_np.flatten() * medv_std + medv_mean
pred_medv_original = pred_np.flatten() * medv_std + medv_mean

original_result_df = pd.DataFrame({
    'Actual_medv_Original': actual_medv_original,
    'Predicted_medv_Original': pred_medv_original,
    'Error_Original': actual_medv_original - pred_medv_original
})
print('원래 medv 단위로 복원한 예측 결과 샘플 10개')
display(original_result_df.head(10))

# 원래 단위 기준의 MSE, RMSE, R2 계산
original_mse = mean_squared_error(actual_medv_original, pred_medv_original)
original_rmse = np.sqrt(original_mse)
original_r2 = r2_score(actual_medv_original, pred_medv_original)

print(f'원래 단위 기준 MSE: {original_mse:.6f}')
print(f'원래 단위 기준 RMSE: {original_rmse:.6f}')
print(f'원래 단위 기준 R² Score: {original_r2:.6f}')

# 17. 단위 기준 실제값 예측 비교 그래프

plt.figure(figsize=(7, 6))
sns.regplot(x=actual_medv_original, y=pred_medv_original)
plt.xlabel('Actual medv original')
plt.ylabel('Predicted Medv Original')
plt.title('Acutal vs predicted MEDV - original scale')
plt.grid(True)
plt.show()

