# 1. import
import torch
import torch.nn as nn
import torch.optim as optim
import numpy as np
import matplotlib.pyplot as plt
import random

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
random.seed(42)
np.random.seed(42)
torch.manual_seed(42)

print('사용 장치: ', device)

# 2. 훈련 데이터셋 만들기

x_train_data = []
y_train_data = []

for i in range(100):
    # 오렌지
    x_train_data.append([random.randint(7, 20), random.randint(80, 130)])
    y_train_data.append(1)

    # 귤
    x_train_data.append([random.randint(1, 10), random.randint(50, 100)])
    y_train_data.append(0) # Changed label from 2 to 0 for tangerine

# numpy 배열로 변환. 실수형
x_train_np = np.array(x_train_data, dtype=np.float32)
y_train_np = np.array(y_train_data, dtype=np.float32)

# BCWithLongistsLoss는 예측값과 정답값의 모양이 같아야 하므로 정답을 (데이터 개수, 1) 모양으로
# 그 전에는 (200,)로 방향이 없이 데이터가 한 줄로 늘어선 리스트 1차원 배열인 반면,
# reshape을 통해 200행 1열의 2차원 행렬이 완성됨
# (-1, 1)은 -1이 위치한 행 값은 나머지 열에 적힌 숫자에 맞춰 자동 계산하라는 의미
y_train_np = y_train_np.reshape(-1, 1)

print('x_train_np: ', x_train_np.shape)
print('y_train_np: ', y_train_np.shape)
print('훈련 데이터 예시: ', x_train_np[:5])
print('훈련 정답 데이터 예시: \n', y_train_np[:5])

# 3. 테스트 데이터 셋 만들기

x_test_data = []
y_test_data = []

for i in range(10):
    # 오렌지
    x_test_data.append([random.randint(7, 20), random.randint(80, 130)])
    y_test_data.append(1)

    # 귤
    x_test_data.append([random.randint(1, 10), random.randint(50, 100)])
    y_test_data.append(0)

# python -> numpy 배열로 변환
x_test_np = np.array(x_test_data, dtype=np.float32)
y_test_np = np.array(y_test_data, dtype=np.float32)

# BCWithLogisticsLoss 는 예측값과 정답값의 모양이 같아야 함
y_test_np = y_test_np.reshape(-1, 1)

print('x_test_np: ', x_test_np.shape)
print('y_test_np: ', y_test_np.shape)
print('테스트 인풋 데이터 예시: ', x_test_np[:5])
print('테스트 아웃풋 데이터 예시: \n', y_test_np[:5])

# Numpy데이터를 PyTorch Tensor로 변환

x_train = torch.tensor(x_train_np, dtype=torch.float32).to(device)
y_train = torch.tensor(y_train_np, dtype=torch.float32).to(device)
x_test = torch.tensor(x_test_np, dtype=torch.float32).to(device)
x_test = torch.tensor(x_test_np, dtype=torch.float32).to(device)
y_test = torch.tensor(y_test_np, dtype=torch.float32).to(device)

# 자료형과 장치 확인
print('x_train: ', x_train.dtype, x_train.device)
print('y_train: ', y_train.dtype, y_train.device)

# 5. PyTorch 모델 정의

class FruitClassifier(nn.Module):
    def __init__(self):
        super(FruitClassifier, self).__init__()

        self.fc1 = nn.Linear(2, 20)
        self.relu1 = nn.ReLU()

        self.fc2 = nn.Linear(20, 10)
        self.relu2 = nn.ReLU()

        self.fc3 = nn.Linear(10, 1)

    def forward(self, x):
        x = self.fc1(x)
        x = self.relu1(x)

        x = self.fc2(x)
        x = self.relu2(x)

        x = self.fc3(x)
        return x

model = FruitClassifier().to(device)
print(model)

# 6. 손실함수 최적화 알고리즘 설정
# BCWithLogitsLoss 는 Sigmoid와 Binary cross entropy를 함께 계산하는 손실 함수
# 모델 출력값이 확률이 아니라 logit일 때 안정적으로 사용
# logit: 딥러닝 모델의 출력층에서 나오는 최종 결과값
# BCEWithLogitsLoss: BCE(Binary Cross Entropy) + Logits
# 보통 이진분류 할 때는 마지막에 sigmoid 함수를 써서 0 ~ 1 사이의 확률로 바꾼 뒤, BCE를 계산
# 이러면 기울기 소실이나 연산 오류 발생하기 쉬움
# BCEWithLogitsLoss를 쓰면 sigmoid 단계 생략하고 logit 값을 직접 함수에 넣는 방식
# 수학적으로 훨씬 더 안정적이고 학습 효율 좋아짐.
criterion = nn.BCEWithLogitsLoss()

# model.parameters()는 학습해야 할 가중치와 편향들을 optimier에게 전달
optimizer = optim.Adam(model.parameters(), lr=0.001)

epochs = 200
batch_size = 10

# 7. 정확도 계산 함수

def calculate_accuracy(logits, labels):
    # torch.sigmoid는 logit 값을 0 ~ 1 사이 확률값으로 변환
    probabilities = torch.sigmoid(logits)

    # 확률이 0.5 이상이면 오렌지, 미만이면 귤
    predictions = (probabilities >= 0.5).float()
    correct = (predictions == labels).float()

    accuracy = correct.mean()
    return accuracy

# 모델 학습시키기

train_losses = []
val_losses = []
train_accuracies = []
val_accuracies = []

# 훈련 데이터의 전체 개수 저장
num_samples = x_train.shape[0] # Changed x_train.shape to x_train.shape[0]

for epoch in range(epochs):
    model.train()

    # 매 epoch 마다 데이터를 섞기 위해 랜덤 순서 인덱스 만듬
    permutation = torch.randperm(num_samples).to(device)

    batch_losses = []

    # batch_size 간격으로 데이터 나누어 미니배치 학습 수행
    for start_idx in range(0, num_samples, batch_size):
        # 현재 미니배치 끝 인덱스 계산
        end_idx = start_idx + batch_size

        # 섞인 인덱스 중 현재 미니배치에 해당하는 인덱스 가져옴
        batch_indices = permutation[start_idx:end_idx]

        # 현재 미니배치 입력 데이터 선택
        batch_x = x_train[batch_indices]
        batcy_y = y_train[batch_indices]

        # 현재 미니배니체 대한 모델 출력 lgot 계산
        logits = model(batch_x)

        # 모델 출력 logits과 실제 비교하여 손실 계산
        loss = criterion(logits, batcy_y)

        # 기울기 초기화
        optimizer.zero_grad()

        loss.backward()
        optimizer.step()
        batch_losses.append(loss.item())

    # 평가 단계
    with torch.no_grad():
        model.eval()
        train_logits = model(x_train)

        # 전체 훈련 데이터 기준 손실값을 계산
        train_loss = criterion(train_logits, y_train).item()
        # 전체 훈련 데이터 기준 정확도 계산
        train_acc = calculate_accuracy(train_logits, y_train).item()

        # 원본 코드의 validation_data()와 동일하게 훈련 데이터 검증
        val_logits = model(x_train)

        # 검증 손실값을 계산
        val_loss = criterion(val_logits, y_train).item()
        # 검증 정확도
        val_acc = calculate_accuracy(val_logits, y_train).item()

    train_losses.append(train_loss)
    val_losses.append(val_loss)
    train_accuracies.append(train_acc)
    val_accuracies.append(val_acc)
    if (epoch + 1) % 20 == 0:
        print(
            f"Epoch [{epoch + 1:3d}/{epochs}] "
            f"train_loss={train_loss:.4f}, "
            f"val_loss={val_loss:.4f}, "
            f"train_acc={train_acc:.4f}, "
            f"val_acc={val_acc:.4f}"
        )

# 9. 모델 평가
with torch.no_grad():
    model.eval()
    test_logits = model(x_test)
    test_loss = criterion(test_logits, y_test).item()
    test_acc = calculate_accuracy(test_logits, y_test).item()

print(f"test loss: {test_loss:.4f}")
print(f"accuracy: {test_acc * 100:.2f}%")

# 10. 학습 결과 그래프


fig, loss_ax = plt.subplots(figsize=(10, 6)) # Changed 'plot' to 'plt'

# 축 x 공유하며 오른쪽 y축 사용할 두 번째 축 생성
acc_ax = loss_ax.twinx()
# 노란색 선
loss_ax.plot(train_losses, 'y', label='train loss')
# 빨간 선
loss_ax.plot(val_losses, 'r', label='val loss')

# 훈련 정확도 변화를 파란색 선
acc_ax.plot(train_accuracies, 'b', label='train acc')
# 검증 정확도 초록 선
acc_ax.plot(val_accuracies, 'g', label='val acc') # Changed 'plt' to 'plot'

# x축 이름
loss_ax.set_xlabel('epoch')
# 왼쪽 y 축이름
loss_ax.set_ylabel('loss')
# 오른쪽 y 축
acc_ax.set_ylabel('accuracy')

loss_ax.legend(loc='upper left') # Changed 'uper' to 'upper'
acc_ax.legend(loc='lower left')

plt.show()

"""# **CIFAR-10 데이터셋 활용한 PyTorch 딥러닝 분류**

이미지 데이터셋을 불러온 뒤 이미지를 1차원 벡터로 펼쳐서 mlp 에 입력하고 10개 클래스 중 하나로 분류하는 구조
"""

# 1. Import
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader, random_split
from torchvision import datasets
from torchvision import transforms
import numpy as np
import matplotlib.pyplot as plt

torch.manual_seed(42)
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print('사용 장치', device)

# 2. 이미지를 PyTorch 텐서로 변환하는 전처리 작업
transform = transforms.Compose([
    # pil 이미지 또는 Numpy 배열 형태의 이미지를 torch.tensor 형태로 변환
    # 동시에 픽셀값 범위를 0 ~ 255 에서 0.0~1.0 사이로 자동 변환
    transforms.ToTensor()
])

# transform 적용하며 CIFAR-10 훈련 데이터, 테스트 다운로드
train_full_dataset = datasets.CIFAR10(
    root='./data',
    train=True,
    download=True,
    transform=transform
)

test_dataset = datasets.CIFAR10(
    root='./data',
    train=False,
    download=True,
    transform=transform
)

# 훈련 데이터 40000, val 데이터 10000
# full 데이터를 훈련용, val용으로 나눔
train_size = 40000
val_size = len(train_full_dataset) - train_size

train_dataset, val_dataset = random_split(
    train_full_dataset,
    [train_size, val_size],
    generator=torch.Generator().manual_seed(42)
)


batch_size = 50
# 훈련 데이터 로더
train_loader = DataLoader(
    train_dataset,
    batch_size=batch_size,
    shuffle=True
)
# 검증 데이터 로더
val_loader = DataLoader(
    val_dataset,
    batch_size=batch_size,
    shuffle=False
)
# 테스트 데이터 로더
test_loader = DataLoader(
    test_dataset,
    batch_size=batch_size,
    shuffle=False
)

# 클래스 이름을 저장.
# 숫자 라벨을 0 ~ 9로 모델은 두고 예측하지만 사람이 이해하기 쉽게 클래스 이름 함께 둠
class_names = train_full_dataset.classes

print('훈련 데이터 개수:', len(train_dataset))
print('검증 데이터 개수:', len(val_dataset))
print('테스트 데이터 개수:', len(test_dataset))
print('클래스 이름:', class_names)

"""CIFAR-10의 각 이미지는 3 x 32 x 32 형태입니다. PyTorch에서는 이미지 텐서를 일반적으로  (채널, 높이, 너비) 순으로 저장합니다. Pytorch모델에서

```
x.view(x.size(0), -1)
```
을 사용하여 미니배치 안의 각 이미지를 3072개 입력값으로 펼칩니다.


"""

# 3. 이미지 구조 확인
# train_loader에서 첫 번째 미니배치 하나 꺼냅니다.
images, labels = next(iter(train_loader))

# image 형태를 출력
# 50은 배치 크기, 3은 RGB 채널, 32는 높이와 너비
print('이미지 배치 형태: ', images.shape)
# label의 형태 출력
# 출력 예: torch.Size([50])이며, 각 이미지의 정답 클래스 번호가 들어 있습니다.
print('라벨 배치 형태: ', labels.shape)


# 첫 번째 이미지의 정답 숫자 라벨 확인
print('첫 번째 이미지 라벨 번호: ', labels[0].item())
print('첫 번째 이미지 클래스 이름: ', class_names[labels[0].item()])

# 시각화를 위해 첫 번째 이미지 텐서 선택
sample_image = images[0]

