# 11. PyTorch 모델 정의
# 대출 상환 여부를 분류하는 신경망 모델
class CreditMLP(nn.Module):
  def __init__(self, input_dim, num_classes):
    super(CreditMLP, self).__init__()

    self.network = nn.Sequential(
        # 1. 완전 연결층: dim개 입력 받아 64개의 값으로 변환
        nn.Linear(input_dim, 64),

        # ReLU는 음수는 0, 양수는 그대로 통과시키는 활성함수
        nn.ReLU(),

        # Dropout은 일부 뉴런을 무작위로 끄는 기법
        nn.Dropout(0.2),

        # 2. 완전 연결층
        nn.Linear(64, 32),
        nn.ReLU(),

        # 3. 출력층
        nn.Linear(32, num_classes)
    )

  def forward(self, x):
    return self.network

# 입력 특성 개수
