# 6. CNN 모델 구현

class FashionCNN(nn.Module):
    def __init__(self):
        super(FashionCNN, self).__init__()

        # 첫 번째 합성곱층
        # in_channels = 1은 흑백 이미지라서 입력 채널이 1개라는 뜻
        # out_channels=32는 32개의 필터를 사용해서 32개 특징 맵을 만들겠다는 뜻
        # kernel_size=2 는 2x2 크기의 필터를 사용
        # pedding='same' 은 입력 이미지의 가로세로 크기가 합성곱 후에도 유지되도록 패딩
        self.conv1 = nn.Conv2d(
            in_channels=1,
            out_channels=32,
            kernel_size=2,
            padding='same'
        )

        # 첫 번째 풀링층
        # kernel_size=2란 필터에서 가장 큰 값을 하나 선택
        # MaxPool2d는 이미지 크기를 줄이면서 중요한 특징을 남기는 역할
        self.pool1 = nn.MaxPool2d(kernel_size=2)

        # 두 번째 합성곱층
        # 첩 번째 합성곱층의 출력 채널이 32개이므로 in_channels=32 입니다.
        # out_channels=64란 64개의 특징맵을 만든다는 뜻
        self.conv2 = nn.Conv2d(
            in_channels=32,
            out_channels=64,
            kernel_size=2,
            padding='same'
        )

        # 두 번째 풀링층입니다.
        # 다시 2x2 영역에서 최댓값을 뽑아 이미지 크기를 절반으로 줄입니다.
        self.pool2 = nn.MaxPool2d(kernel_size=2)

        # 활성화 함수
        self.relu = nn.ReLU()

        # 완전연결층
        # 마지막 풀링층의 출력 사이즈 받아와 최종 특징 수로 사용
        # 출력 크기 128은 하이퍼파라미터. 128개의 은닉노드 사용하겠다는 뜻
        self.fc1 = nn.Linear(64 * 7 * 7, 128)

        # 출력층
        # softmax 확률이 아니라 CrossEntropyLoss에 들어갈 logits출력
        self.fc2 = nn.Linear(128, M_CLASS)

    def forward(self, x):
        # 입력 x의 모양은 (batch_size, 1, 28, 28)
        # 첫 번째 합성곱층을 통과해 32개 특징맵 만듬
        x = self.conv1(x)
        x = self.relu(x)
        x = self.pool1(x)

        x = self.conv2(x)
        x = self.relu(x)
        x = self.pool2(x)

        # 합성곱층의 출력은 4차원 텐서
        # 완전연결층에 넣기 위해 2차원 텐서로 펼침
        # x.size(0)은 현재 batch_size를 의미
        # -1은 나머지 알아서 계산
        x = x.view(x.size(0), -1)

        # 첫 번째 완전연결층을 통과하여 128개 특징으로 변환
        x = self.fc1(x)
        x = self.relu(x)
        x = self.fc2(x)

        return x

